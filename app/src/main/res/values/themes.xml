<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="walnut_deep">#FF1E120C</color>
    <color name="walnut">#FF2B1A12</color>

    <!-- Compose draws everything; this theme only controls the window behind it and the system bars. -->
    <style name="Theme.VintageVinyl" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/walnut_deep</item>
        <item name="android:statusBarColor">@color/walnut_deep</item>
        <item name="android:navigationBarColor">@color/walnut_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
